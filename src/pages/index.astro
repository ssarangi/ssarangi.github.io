---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getListedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getListedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header wide />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-wide"
  >
    <section
      id="hero"
      class="border-border grid gap-10 border-b pt-10 pb-12 lg:grid-cols-[1.4fr_1fr] lg:items-center"
    >
      <div>
        <p
          class="border-accent/40 text-accent inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs"
        >
          <span class="bg-accent size-1.5 rounded-full" aria-hidden="true"
          ></span>
          Now writing: inference engines &amp; tool-call parsing
        </p>
        <h1
          class="mt-5 text-4xl leading-[1.1] font-bold tracking-tight sm:text-5xl"
        >
          From tokens to <span class="text-accent">kernels</span>.<br />
          Notes on AI inference infrastructure.
        </h1>
        <p class="text-muted-foreground mt-5 max-w-xl text-lg">
          I'm Satyajit, a systems engineer. I write long-form deep dives with
          code, math and benchmarks on how inference stacks actually work.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="bg-accent text-accent-foreground rounded-lg px-5 py-2.5 font-semibold transition-opacity hover:opacity-90"
          >
            Read the posts
          </a>
          <a
            href={getRelativeLocaleUrl(locale, "projects")}
            class="border-border hover:border-accent rounded-lg border px-5 py-2.5 font-semibold transition-colors"
          >
            See projects
          </a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1 font-mono text-sm">
          {
            [
              ["GitHub", "https://github.com/ssarangi"],
              ["LinkedIn", "https://www.linkedin.com/in/satyajitsarangi/"],
              ["X", "https://x.com/ssarangi"],
              ["RSS", `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`],
              ["Email", "mailto:satyajit.sarangi@gmail.com"],
            ].map(([label, href]) => (
              <li>
                <a class="text-muted-foreground hover:text-accent" {href} rel="me">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="border-border bg-muted/40 rounded-xl border p-6"
        aria-labelledby="focus-heading"
      >
        <h2
          id="focus-heading"
          class="mb-4 font-mono text-xs font-bold tracking-widest uppercase"
        >
          Focus areas
        </h2>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-3 font-mono text-sm">
          {
            [
              "Inference engines",
              "Tool-call parsing",
              "LoRA serving",
              "Constrained decoding",
              "Compilers & IR",
              "Benchmarks",
            ].map(item => (
              <li class="flex gap-2">
                <span class="text-accent" aria-hidden="true">
                  &gt;
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-12">
          <h2 class="font-mono text-xl font-bold tracking-tight">
            <span class="text-accent">//</span> {t.home.featured}
          </h2>
          <ul class="mt-4 grid gap-x-5 md:grid-cols-2">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12">
          <h2 class="font-mono text-xl font-bold tracking-tight">
            <span class="text-accent">//</span> {t.home.recentPosts}
          </h2>
          <ul class="mt-4 grid gap-x-5 md:grid-cols-2">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-10 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer wide />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
