---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import config from "@/config";

type Project = {
  name: string;
  blurb: string;
  repo?: string;
  status: "active" | "in progress" | "archived";
  tags: string[];
};
const projects: Project[] = [
  {
    name: "AI infra tool-call conformance suite",
    blurb:
      "A test suite that checks whether inference engines parse and stream model tool calls the way their documentation says they do, across models and chat templates.",
    status: "in progress",
    tags: ["inference", "tool calling", "testing"],
  },
  {
    name: "PyVyM",
    blurb:
      "A virtual machine for Python, written in Python, with a debugger and a JIT experiment.",
    repo: "https://github.com/ssarangi/PyVyM",
    status: "archived",
    tags: ["python", "vm", "compilers"],
  },
  {
    name: "osmpy",
    blurb:
      "OpenStreetMap rendering with matplotlib and vispy, plus simple routing with Dijkstra and A*.",
    repo: "https://github.com/ssarangi/osmpy",
    status: "archived",
    tags: ["python", "graphics", "routing"],
  },
];
---

<Layout
  title={`Projects | ${config.site.title}`}
  description="Open-source projects and experiments."
>
  <Header />
  <Main pageTitle="Projects" pageDesc="Open-source work and experiments.">
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        projects.map(p => (
          <li class="border-border flex flex-col rounded border p-4">
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-lg font-semibold">{p.name}</h2>
              <span
                class:list={[
                  "rounded border px-1.5 py-0.5 text-xs whitespace-nowrap",
                  p.status === "in progress"
                    ? "border-accent text-accent"
                    : "border-border text-muted-foreground",
                ]}
              >
                {p.status}
              </span>
            </div>
            <p class="mt-2 flex-1 text-[0.95rem]">{p.blurb}</p>
            <div class="text-muted-foreground mt-3 flex flex-wrap gap-x-3 text-xs">
              {p.tags.map(t => (
                <span>#{t}</span>
              ))}
            </div>
            {p.repo ? (
              <a
                class="text-accent mt-3 text-sm hover:underline"
                href={p.repo}
                rel="noopener"
              >
                Repository →
              </a>
            ) : (
              <span class="text-muted-foreground mt-3 text-sm">
                Repository coming soon
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
