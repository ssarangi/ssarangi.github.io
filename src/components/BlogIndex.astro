---
import TagSidebar from "./TagSidebar.astro";

type Props = { title: string; desc?: string; active?: string };
const { title, desc, active } = Astro.props;
---

<main id="main-content" class="app-wide pb-6">
  <div class="pt-2 pb-4">
    <h1 class="font-mono text-2xl font-bold tracking-tight sm:text-3xl">
      <span class="text-accent">&gt;</span>&nbsp;{title}
    </h1>
    {desc && <p class="text-muted-foreground mt-2">{desc}</p>}
  </div>
  <div class="grid gap-6 lg:grid-cols-[14rem_1fr] lg:items-start lg:gap-8">
    <TagSidebar {active} />
    <div class="-mt-4"><slot /></div>
  </div>
</main>
