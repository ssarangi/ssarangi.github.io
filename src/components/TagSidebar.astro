---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getListedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = { active?: string };
const { active } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const posts = getListedPosts(await getCollection("posts"));
const counts = new Map<string, { name: string; n: number }>();
for (const p of posts)
  for (const name of p.data.tags) {
    const slug = slugifyStr(name);
    const c = counts.get(slug) ?? { name, n: 0 };
    c.n++;
    counts.set(slug, c);
  }
const items = [...counts.entries()]
  .filter(([slug, { n }]) => n >= 2 || slug === active)
  .sort(
  (a, b) => b[1].n - a[1].n || a[0].localeCompare(b[0])
);
---

<nav
  aria-label="Filter posts by tag"
  class="border-border bg-muted/40 rounded-xl border p-5 lg:sticky lg:top-6"
>
  <a
    href={getRelativeLocaleUrl(locale, "posts")}
    class:list={[
      "font-mono text-xs font-bold tracking-widest uppercase",
      active ? "text-muted-foreground hover:text-accent" : "text-accent",
    ]}
  >
    All posts <span>({posts.length})</span>
  </a>
  <ul class="mt-3 flex flex-wrap gap-1.5 font-mono text-sm lg:block lg:space-y-0.5">
    {
      items.map(([slug, { name, n }]) => (
        <li>
          <a
            href={getRelativeLocaleUrl(locale, `tags/${slug}/`)}
            aria-current={active === slug ? "page" : undefined}
            class:list={[
              "hover:text-accent flex items-baseline justify-between gap-3 rounded px-2 py-1 transition-colors",
              active === slug
                ? "bg-accent text-accent-foreground hover:text-accent-foreground"
                : "text-foreground",
            ]}
          >
            <span>{name}</span>
            <span class="text-muted-foreground text-xs">{n}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <a
    href={getRelativeLocaleUrl(locale, "tags")}
    class="text-muted-foreground hover:text-accent mt-3 inline-block font-mono text-xs"
  >
    all tags &rarr;
  </a>
</nav>
