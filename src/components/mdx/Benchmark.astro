---
type Row = Record<string, string | number | null>;
type Props = {
  columns: {
    key: string;
    label: string;
    unit?: string;
    digits?: number;
    better?: "lower" | "higher";
  }[];
  rows: Row[];
  caption?: string;
  /** Highlight the best value in each column that sets `better`. */
  highlightBest?: boolean;
};
const { columns, rows, caption, highlightBest = true } = Astro.props;

const best = (key: string, better?: "lower" | "higher") => {
  if (!better || !highlightBest) return null;
  const vals = rows
    .map(r => r[key])
    .filter((v): v is number => typeof v === "number");
  if (!vals.length) return null;
  return better === "lower" ? Math.min(...vals) : Math.max(...vals);
};
const fmt = (v: string | number | null, digits?: number) =>
  v === null || v === undefined
    ? "—"
    : typeof v === "number"
      ? v.toLocaleString("en-US", {
          minimumFractionDigits: digits ?? 0,
          maximumFractionDigits: digits ?? 2,
        })
      : v;
---

<div class="bench-wrap table-wrapper">
  <table class="bench">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {
          columns.map((c, i) => (
            <th scope="col" class={i === 0 ? "text-start" : "text-end"}>
              {c.label}
              {c.unit && <span class="unit"> ({c.unit})</span>}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map(r => (
          <tr>
            {columns.map((c, i) => {
              const v = r[c.key];
              const isBest =
                i > 0 && typeof v === "number" && v === best(c.key, c.better);
              return i === 0 ? (
                <th scope="row" class="text-start font-medium">
                  {v}
                </th>
              ) : (
                <td class:list={["text-end", { best: isBest }]}>
                  {fmt(v, c.digits)}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .bench td,
  .bench th {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .bench caption {
    caption-side: bottom;
    padding-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted-foreground);
    text-align: start;
  }
  .unit {
    color: var(--muted-foreground);
    font-weight: 400;
  }
  .best {
    font-weight: 700;
    color: var(--accent);
  }
</style>
