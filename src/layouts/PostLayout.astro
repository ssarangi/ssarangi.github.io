---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDate?: Date;
  updatedDate?: Date | null;
  tags?: string[];
  author?: string;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDate,
  updatedDate,
  tags,
  author = site.author,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title?.replace(` | ${site.title}`, "") ?? site.title,
  description,
  image: ogImage,
  mainEntityOfPage: canonicalURL ?? Astro.url.href,
  ...(tags?.length && { keywords: tags.join(", ") }),
  ...(pubDate && { datePublished: pubDate.toISOString() }),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};

// JSON.stringify leaves `<` alone, so a title containing `</script>` would
// end the ld+json block early. `\u003c` reads back as `<` for JSON parsers.
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c"
);
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <slot name="head" />
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )
    }
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </Fragment>

  <slot />
</Layout>
